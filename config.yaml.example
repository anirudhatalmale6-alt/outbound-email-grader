# =====================================================================
#  Outbound email grader
#
#  Copy this file to config.yaml and fill it in.
#  Lines starting with # are notes.
# =====================================================================

google:
  # How the grader signs in.
  #
  # "oauth"           - sign in once in a browser as the archive mailbox.
  #                     Reaches that ONE mailbox and nothing else. No key
  #                     file. Works where key files are blocked by policy.
  #                     Run: python3 authorise.py
  # "service_account" - domain-wide delegation. No interactive sign-in, so
  #                     it suits an unattended server, but the key can act
  #                     as any user in the Workspace and only this file
  #                     keeps it aimed at the right mailbox.
  auth: oauth

  # --- oauth only ---
  # Downloaded from Cloud console > Credentials > OAuth client ID >
  # Desktop app. Written by you.
  oauth_client_file: oauth_client.json
  # Written by authorise.py. Treat it like a password.
  oauth_token_file: token.json

  # "archive"     - read ONE mailbox that every producer BCCs. Recommended.
  # "per_mailbox" - open each producer's own Sent folder.
  #
  # Archive is better in every way that matters: one account to authorise
  # instead of the whole domain, it is a copy so nothing here can touch
  # anyone's real mail, and the whole thread is visible so a follow-up can
  # be told apart from a first contact.
  mode: archive

  # The BCC archive address. Only used in archive mode.
  # Check this spelling character by character. If it is wrong the grader
  # reads an empty mailbox and reports nothing, every day, without error.
  archive_mailbox: cortex@yourcompany.com

  # --- service_account only ---
  # The JSON key file. Keep it next to this file and out of any shared
  # drive. Setup steps: docs/GOOGLE-SETUP.md
  service_account_file: service-account.json

  # A Google Workspace admin address. Used to send the reports from.
  delegated_admin: admin@yourcompany.com

  # Your Workspace domain.
  domain: yourcompany.com

anthropic:
  # Leave blank to read ANTHROPIC_API_KEY from the environment instead,
  # which is the better habit.
  api_key:
  model: claude-opus-5
  # low | medium | high. medium is the right balance for grading.
  effort: medium

# ---------------------------------------------------------------------
#  Who gets graded
# ---------------------------------------------------------------------
producers:
  - email: producer1@yourcompany.com
    name: First Producer
    # Where their own report goes. Blank = their own address.
    report_to:
    active: true

  - email: producer2@yourcompany.com
    name: Second Producer

# ---------------------------------------------------------------------
#  What counts as a gradeable email
# ---------------------------------------------------------------------
scope:
  # Grade follow-ups as well as first contacts. The grader is told which
  # touch it is looking at, so a follow-up is judged as a follow-up -
  # shorter, no re-introduction, a new reason to reply.
  follow_ups: true

  # Stop grading after this many touches to the same person. Past four,
  # the problem is the sequence, not the writing.
  max_touch: 4

  # Once the prospect has replied it is a conversation, not outreach, and
  # a cold-email standard measures nothing useful about it. Leave false.
  grade_after_reply: false

  # Only relevant in per_mailbox mode, where thread position is unknown.
  first_contact_only: false

  # Mail to these domains is internal and is never graded. The Workspace
  # domain above is included automatically.
  internal_domains:
    - yourcompany.com

  # Individual addresses or whole domains to leave alone entirely.
  exclude_recipients:
    - accountant@example.com
    - legal.example.com

  # Anything shorter than this many characters is not worth grading.
  min_body_chars: 40

  # Only set this true if the call reliably reaches THE PERSON BEING EMAILED.
  #
  # It is narrower than it sounds. If your producers phone an office and an
  # assistant gives them the address, the recipient has never spoken to you --
  # so an email saying they asked to be contacted is untrue to the only person
  # who matters, and should keep being flagged. That is the common case, which
  # is why this stays false.
  #
  # When true: "as you requested" stops being flagged, and the writing half is
  # told about the call so it stops asking for a cold opening.
  preceded_by_call: false

# ---------------------------------------------------------------------
#  Scoring
# ---------------------------------------------------------------------
scoring:
  # Rules you have decided not to be measured on. Findings for these are
  # dropped before scoring, and every report states which ones are off --
  # otherwise a switched-off rule and a rule nobody is failing look identical.
  #
  # Think hard before disabling either of these two. They are the two hard
  # requirements in CAN-SPAM for US commercial email, the penalty is assessed
  # per message, and neither needs an ugly footer to satisfy:
  #   compliance.no_opt_out         "if you'd rather not hear from me, just
  #                                  reply and say so" is enough
  #   compliance.no_postal_address  a PO box in the signature is enough
  #
  # A code that does not exist is an error, not a shrug -- a typo here would
  # otherwise disable nothing while looking like it disabled something.
  disabled_rules: []

# ---------------------------------------------------------------------
#  Reporting
# ---------------------------------------------------------------------
reporting:
  manager_email: you@yourcompany.com

  # Reports are sent from here.
  # Blank = the archive mailbox in oauth mode, delegated_admin otherwise.
  #
  # In oauth mode this really has to be the mailbox you signed in as.
  # Gmail will not honour a From header that account does not own - it
  # rewrites it silently - so a mismatch is refused rather than sending
  # reports that claim to be from someone they are not.
  send_from:

  # Set true only if send_from above is a verified send-as alias on the
  # mailbox that signed in. Then the mismatch check is skipped.
  send_from_is_alias: false

  # TRUE = only the manager gets a report. The producers get nothing.
  # Leave this on for the first week or two. Read the grades yourself,
  # decide whether you agree with them, and only then turn it off.
  # An automated email telling somebody they scored 54 is hard to take
  # back.
  shadow_mode: true

  subject_manager: "Outbound email report - {date}"
  subject_producer: "Your outbound email report - {date}"

# ---------------------------------------------------------------------
#  Running
# ---------------------------------------------------------------------
run:
  lookback_days: 1
  max_emails_per_producer: 200
  max_threads: 1000

  # Warn when a producer's mail never reaches the archive. Worth keeping on:
  # a broken BCC rule and a producer who sent nothing look identical in the
  # data, and only one of those is the producer's fault.
  quiet_producer_warning: true
  database: grader.sqlite3
  # The written standard everything is graded against. This is the
  # Gemini document - put it here as plain text or markdown.
  rubric_file: rubric.md
